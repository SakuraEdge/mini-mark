{
  "name": "moye-markdown",
  "version": "1.0.2",
  "private": true,
  "description": "A fast, local-first Windows Markdown editor with Chinese slash commands.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop": "dotnet run --project native/Moye.csproj",
    "package:win": "npm run build && dotnet publish native/Moye.csproj -c Release -r win-x64 --self-contained true -o release/Moye",
    "test:native": "dotnet run --project native-tests/Moye.Tests.csproj"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "katex": "0.19.1",
    "lucide": "1.66.0",
    "markdown-it": "15.0.3",
    "markdown-it-task-lists": "2.1.1",
    "markdown-it-texmath": "1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
